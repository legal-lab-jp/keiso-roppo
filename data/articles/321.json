  "article": {
    "id": "jp-323AC0000000131-a321",
    "number": "321",
    "displayNumber": "第三百二十一条",
    "title": "被告人以外の者の供述書面",
    "path": [
      "第二編 第一審",
      "第三章 公判",
      "第四節 証拠"
    ],
    "topic": "伝聞・証拠例外",
    "priority": {
      "essay": "A",
      "short": "A"
    },
    "loadLabel": "書面類型の振分け",
    "keywords": "供述書 供述調書 署名 押印 裁判官面前調書 検察官面前調書 司法警察員面前調書 特信情況 検証調書 鑑定書",
    "oneLine": "被告人以外の者の供述書面を作成主体と信用性保障に応じて分類し、伝聞例外の要件を定めます。",
    "trigger": "被告人以外の者の供述書、供述調書、検証調書又は鑑定書を犯罪事実の認定に使おうとするとき。",
    "overview": "1項は署名・押印のある供述書面を、裁判官面前調書、検察官面前調書、その他の書面に分け、類型ごとに異なる要件を課します。2項は裁判所等の調書、3項は捜査機関の検証調書、4項は鑑定書の例外です。まず書面の作成主体を確定し、対応する号・項だけを当てはめます。",
    "learning": {
      "remember": "1号＝裁判官、2号＝検察官、3号＝その他。2項＝裁判所等、3項＝捜査機関の検証、4項＝鑑定書です。",
      "understand": "公判廷外の供述を例外的に使うため、書面の作成過程に応じて反対尋問の代替となる信用性保障を段階化しています。",
      "lookup": "実況見分調書の現場指示・再現供述は、調書本体と供述部分の立証趣旨を分け、必要なら324条も検討します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a321-p1-intro",
        "paragraph": 1,
        "item": "intro",
        "itemMark": null,
        "label": "第321条第1項柱書",
        "studyTitle": "供述書面の形式と限定",
        "purpose": "被告人以外の供述書面について署名・押印による作成者の特定を求め、証拠能力を各号の例外に限定します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a321-p1-intro-s01",
            "role": "requirement",
            "tag": "本人作成の供述書",
            "text": "被告人以外の者が作成した供述書又は"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-intro-s02",
            "role": "requirement",
            "tag": "供述録取書＋署名・押印",
            "text": "その者の供述を録取した書面で供述者の署名若しくは押印のあるものは、"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-intro-s03",
            "role": "limit",
            "tag": "各号の場合に限定",
            "text": "次に掲げる場合に限り、"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-intro-s04",
            "role": "effect",
            "tag": "証拠能力",
            "text": "これを証拠とすることができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a321-p1-i1",
        "paragraph": 1,
        "item": 1,
        "itemMark": "一",
        "label": "第321条第1項第1号",
        "studyTitle": "裁判官面前調書",
        "purpose": "裁判官面前という手続的保障を踏まえ、供述不能又は公判供述との相違がある場合に証拠使用を認めます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a321-p1-i1-s01",
            "role": "requirement",
            "tag": "裁判官面前調書",
            "text": "裁判官の面前（映像と音声の送受信により相手の状態を相互に認識しながら通話をすることができる方法による場合を含む。次号において同じ。）における供述を録取した書面については、"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-i1-s02",
            "role": "requirement",
            "tag": "供述不能",
            "text": "その供述者が死亡、精神若しくは身体の故障、所在不明若しくは国外にいるため公判準備若しくは公判期日において供述することができないとき、又は"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-i1-s03",
            "role": "requirement",
            "tag": "公判供述との相違",
            "text": "供述者が公判準備若しくは公判期日において前の供述と異なつた供述をしたとき。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a321-p1-i2",
        "paragraph": 1,
        "item": 2,
        "itemMark": "二",
        "label": "第321条第1項第2号",
        "studyTitle": "検察官面前調書",
        "purpose": "供述不能又は相反・実質的不一致に加え、前の供述を信用すべき特別の情況を要求して検察官調書の使用を限定します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a321-p1-i2-s01",
            "role": "requirement",
            "tag": "検察官面前調書",
            "text": "検察官の面前における供述を録取した書面については、"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-i2-s02",
            "role": "requirement",
            "tag": "供述不能又は相反・実質的不一致",
            "text": "その供述者が死亡、精神若しくは身体の故障、所在不明若しくは国外にいるため公判準備若しくは公判期日において供述することができないとき、又は公判準備若しくは公判期日において前の供述と相反するか若しくは実質的に異なつた供述をしたとき。"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-i2-s03",
            "role": "limit",
            "tag": "相対的特信情況",
            "text": "ただし、公判準備又は公判期日における供述よりも前の供述を信用すべき特別の情況の存するときに限る。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a321-p1-i3",
        "paragraph": 1,
        "item": 3,
        "itemMark": "三",
        "label": "第321条第1項第3号",
        "studyTitle": "その他の供述書面",
        "purpose": "警察官面前調書等について、供述不能・不可欠性・絶対的特信情況を累積的に要求し、例外を厳格に限定します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a321-p1-i3-s01",
            "role": "requirement",
            "tag": "1・2号以外の書面",
            "text": "前二号に掲げる書面以外の書面については、"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-i3-s02",
            "role": "requirement",
            "tag": "供述不能",
            "text": "供述者が死亡、精神若しくは身体の故障、所在不明又は国外にいるため公判準備又は公判期日において供述することができず、"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-i3-s03",
            "role": "requirement",
            "tag": "犯罪事実の証明に不可欠",
            "text": "かつ、その供述が犯罪事実の存否の証明に欠くことができないものであるとき。"
          },
          {
            "id": "jp-323AC0000000131-a321-p1-i3-s04",
            "role": "limit",
            "tag": "絶対的特信情況",
            "text": "ただし、その供述が特に信用すべき情況の下にされたものであるときに限る。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a321-p2",
        "paragraph": 2,
        "item": null,
        "itemMark": null,
        "label": "第321条第2項",
        "studyTitle": "裁判所等の調書",
        "purpose": "裁判手続の公正さと作成過程の信用性を踏まえ、裁判所等の供述録取書・検証調書を例外的に証拠とします。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a321-p2-s01",
            "role": "requirement",
            "tag": "公判供述録取書・裁判所等の検証調書",
            "text": "被告人以外の者の公判準備若しくは公判期日における供述を録取した書面又は裁判所若しくは裁判官の検証の結果を記載した書面は、"
          },
          {
            "id": "jp-323AC0000000131-a321-p2-s02",
            "role": "limit",
            "tag": "1項の例外",
            "text": "前項の規定にかかわらず、"
          },
          {
            "id": "jp-323AC0000000131-a321-p2-s03",
            "role": "effect",
            "tag": "証拠能力",
            "text": "これを証拠とすることができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a321-p3",
        "paragraph": 3,
        "item": null,
        "itemMark": null,
        "label": "第321条第3項",
        "studyTitle": "捜査機関の検証調書",
        "purpose": "捜査機関作成の検証調書について、作成者の証人尋問と真正作成の供述により作成過程を吟味できるようにします。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a321-p3-s01",
            "role": "requirement",
            "tag": "捜査機関の検証調書",
            "text": "検察官、検察事務官又は司法警察職員の検証の結果を記載した書面は、"
          },
          {
            "id": "jp-323AC0000000131-a321-p3-s02",
            "role": "requirement",
            "tag": "作成者の証人尋問・真正作成供述",
            "text": "その供述者が公判期日において証人として尋問を受け、その真正に作成されたものであることを供述したときは、"
          },
          {
            "id": "jp-323AC0000000131-a321-p3-s03",
            "role": "limit",
            "tag": "1項の例外",
            "text": "第一項の規定にかかわらず、"
          },
          {
            "id": "jp-323AC0000000131-a321-p3-s04",
            "role": "effect",
            "tag": "証拠能力",
            "text": "これを証拠とすることができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a321-p4",
        "paragraph": 4,
        "item": null,
        "itemMark": null,
        "label": "第321条第4項",
        "studyTitle": "鑑定書",
        "purpose": "鑑定人作成の鑑定書について、作成者尋問等による作成過程の吟味を要求します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a321-p4-s01",
            "role": "requirement",
            "tag": "鑑定人作成の鑑定書",
            "text": "鑑定の経過及び結果を記載した書面で鑑定人の作成したものについても、"
          },
          {
            "id": "jp-323AC0000000131-a321-p4-s02",
            "role": "effect",
            "tag": "3項と同じ",
            "text": "前項と同様である。"
          }
        ]
      }
    ],
