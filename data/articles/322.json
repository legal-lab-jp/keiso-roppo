    "number": "322",
    "displayNumber": "第三百二十二条",
    "title": "被告人の供述書面",
    "path": [
      "第二編 第一審",
      "第三章 公判",
      "第四節 証拠"
    ],
    "topic": "自白・被告人供述",
    "priority": {
      "essay": "A",
      "short": "A"
    },
    "loadLabel": "不利益供述＋任意性",
    "keywords": "被告人供述書 供述調書 署名 押印 不利益事実の承認 自白 任意性 特信情況",
    "oneLine": "被告人の供述書面について、不利益事実の承認又は特信情況を求め、任意性のない疑いがあれば排除します。",
    "trigger": "被告人の供述書・供述調書を証拠とするとき、特に不利益供述又は自白を含む書面の証拠能力を検討するとき。",
    "overview": "被告人自身の供述書面は、被告人以外の者を対象とする321条ではなく322条で処理します。1項は署名・押印のある書面に不利益事実の承認又は特信情況を求め、不利益承認には自白でなくても319条に準じた任意性を要求します。2項は公判準備・公判供述の録取書に任意性を要求します。",
    "learning": {
      "remember": "被告人書面＋署名・押印＋不利益事実の承認又は特信情況。不利益承認には自白でなくても任意性が必要です。",
      "understand": "被告人の反対尋問権よりも、自己負罪供述の任意性と作成過程の信用性を中心に規律します。",
      "lookup": "自白なら319条1項の任意性と2項の補強法則も重ね、第三者が法廷で被告人の供述を語る場合は324条1項へ進みます。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a322-p1",
        "paragraph": 1,
        "item": null,
        "itemMark": null,
        "label": "第322条第1項",
        "studyTitle": "被告人供述書面の証拠能力",
        "purpose": "被告人供述書面の証拠使用を信用性のある場合に限定し、不任意な不利益供述を排除します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a322-p1-s01",
            "role": "requirement",
            "tag": "被告人作成・録取＋署名押印",
            "text": "被告人が作成した供述書又は被告人の供述を録取した書面で被告人の署名若しくは押印のあるものは、"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s02",
            "role": "requirement",
            "tag": "不利益事実の承認",
            "text": "その供述が被告人に不利益な事実の承認を内容とするものであるとき、又は"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s03",
            "role": "requirement",
            "tag": "特信情況",
            "text": "特に信用すべき情況の下にされたものであるときに限り、"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s04",
            "role": "effect",
            "tag": "証拠能力",
            "text": "これを証拠とすることができる。"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s05",
            "role": "limit",
            "tag": "不利益承認書面",
            "text": "但し、被告人に不利益な事実の承認を内容とする書面は、"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s06",
            "role": "limit",
            "tag": "自白以外にも適用",
            "text": "その承認が自白でない場合においても、"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s07",
            "role": "limit",
            "tag": "319条準用",
            "text": "第三百十九条の規定に準じ、"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s08",
            "role": "requirement",
            "tag": "任意性に疑い",
            "text": "任意にされたものでない疑があると認めるときは、"
          },
          {
            "id": "jp-323AC0000000131-a322-p1-s09",
            "role": "effect",
            "tag": "証拠能力を否定",
            "text": "これを証拠とすることができない。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a322-p2",
        "paragraph": 2,
        "item": null,
        "itemMark": null,
        "label": "第322条第2項",
        "studyTitle": "公判供述録取書",
        "purpose": "公判準備又は公判期日の被告人供述を録取した書面にも任意性を要求します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a322-p2-s01",
            "role": "requirement",
            "tag": "公判準備・公判供述録取書",
            "text": "被告人の公判準備又は公判期日における供述を録取した書面は、"
          },
          {
            "id": "jp-323AC0000000131-a322-p2-s02",
            "role": "requirement",
            "tag": "任意性",
            "text": "その供述が任意にされたものであると認めるときに限り、"
          },
          {
            "id": "jp-323AC0000000131-a322-p2-s03",
            "role": "effect",
            "tag": "証拠能力",
            "text": "これを証拠とすることができる。"
          }
        ]
      }
    ],
