          {
            "id": "jp-323AC0000000131-a100-p2-s02",
            "role": "requirement",
            "tag": "事件関連性",
            "text": "被告事件に関係があると認めるに足りる状況のあるものに限り、"
          },
          {
            "id": "jp-323AC0000000131-a100-p2-s03",
            "role": "effect",
            "tag": "差押え・提出",
            "text": "これを差し押え、又は提出させることができる。"
          }
