          {
            "id": "jp-323AC0000000131-a100-p1-s03",
            "role": "actor",
            "tag": "対象物・所持者",
            "text": "郵便物、信書便物又は電信に関する書類で法令の規定に基づき通信事務を取り扱う者が保管し、又は所持するものを"
          },
          {
            "id": "jp-323AC0000000131-a100-p1-s04",
            "role": "effect",
            "tag": "差押え・提出",
            "text": "差し押え、又は提出させることができる。"
          }
