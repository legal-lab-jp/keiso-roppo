  "study": {
    "title": "住居等での令状執行と立会い",
    "topic": "捜索・差押え",
    "priority": {
      "essay": "B",
      "preliminaryShort": "A"
    },
    "loadLabel": "立会人を区別",
    "oneLine": "公務所や住居等での捜索・差押えに第三者等を立ち会わせ、執行の公正と手続の透明性を確保します。",
    "trigger": "住居や事務所の捜索時に誰も立ち会わせなかった、誰を立会人にすべきかが問題となるとき。",
    "overview": "閉鎖的な空間で行われる強制処分の公正を担保するため、公務所ではその長等、住居等では住居主・看守者等を立ち会わせます。これらの者が不在なら隣人又は地方公共団体職員が代替します。捜査では222条1項により準用されます。",
    "learning": {
      "remember": "公務所は長等。住居等は住居主・看守者等、不可能なら隣人又は地方公共団体職員。",
      "understand": "立会いは捜索対象者の同意を得る制度ではなく、執行の公正・明確性を確保する手続保障であること。",
      "lookup": "220条による被疑者捜索で急速を要する場合は、222条2項が本条2項の例外を置きます。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a114-p1",
        "label": "第114条第1項",
        "studyTitle": "公務所",
        "purpose": "公務所内の令状執行に組織の責任者を立ち会わせ、処分の公正と対象の管理を確保します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a114-p1-s01",
            "role": "requirement",
            "tag": "公務所内",
            "text": "公務所内で差押状又は捜索状の執行をするときは、"
          },
          {
            "id": "jp-323AC0000000131-a114-p1-s02",
            "role": "effect",
            "tag": "通知・立会い",
            "text": "その長又はこれに代わるべき者に通知してその処分に立ち会わせなければならない。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a114-p2",
        "label": "第114条第2項",
        "studyTitle": "住居等",
        "purpose": "住居等の閉鎖空間での処分に関係者又は中立的な代替者を立ち会わせ、執行経過を明確にします。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a114-p2-s01",
            "role": "limit",
            "tag": "公務所を除く",
            "text": "前項の規定による場合を除き、"
          },
          {
            "id": "jp-323AC0000000131-a114-p2-s02",
            "role": "requirement",
            "tag": "住居等での執行",
            "text": "人の住居又は人の看守する邸宅、建造物若しくは船舶内で差押状又は捜索状の執行をするときは、"
          },
          {
            "id": "jp-323AC0000000131-a114-p2-s03",
            "role": "effect",
            "tag": "関係者の立会い",
            "text": "住居主若しくは看守者又はこれらの者に代わるべき者をこれに立ち会わせなければならない。"
          },
          {
            "id": "jp-323AC0000000131-a114-p2-s04",
            "role": "requirement",
            "tag": "関係者不在",
            "text": "これらの者を立ち会わせることができないときは、"
          },
          {
            "id": "jp-323AC0000000131-a114-p2-s05",
            "role": "effect",
            "tag": "代替立会人",
            "text": "隣人又は地方公共団体の職員を立ち会わせなければならない。"
          }
        ]
      }
    ],
