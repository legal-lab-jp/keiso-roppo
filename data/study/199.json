  "articleId": "jp-323AC0000000131-a199",
  "study": {
    "title": "通常逮捕",
    "topic": "逮捕",
    "priority": {
      "essay": "A",
      "preliminaryShort": "A"
    },
    "loadLabel": "最優先",
    "oneLine": "相当な犯罪嫌疑と裁判官の逮捕状を通常逮捕の原則とし、逮捕状発付と軽微事件の限界を定めます。",
    "trigger": "令状による逮捕の要件、逮捕状発付時の嫌疑・必要性、軽微事件の逮捕制限、再逮捕の手続を検討するとき。",
    "overview": "身体の自由を強く制約する逮捕について、事前に裁判官が犯罪嫌疑と逮捕の必要性を審査する令状主義を具体化します。1項は執行側、2項は令状発付側の要件を定めます。",
    "learning": {
      "remember": "1項の相当な嫌疑＋事前の逮捕状、2項ただし書の「明らかに逮捕の必要がない」場合。軽微事件の例外は構造を押さえます。",
      "understand": "1項は逮捕をする側、2項は裁判官が逮捕状を発付する側の規定であること。",
      "lookup": "軽微事件の罰金額と3項の同一犯罪事実についての前の逮捕状請求・発付の通知は、必要時に確認します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a199-p1",
        "label": "第199条第1項",
        "studyTitle": "最優先",
        "purpose": "通常逮捕を相当な犯罪嫌疑と事前の司法審査にかからせ、不当な身柄拘束を防ぎます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a199-p1-s01",
            "role": "actor",
            "tag": "逮捕主体",
            "text": "検察官、検察事務官又は司法警察職員は、"
          },
          {
            "id": "jp-323AC0000000131-a199-p1-s02",
            "role": "requirement",
            "tag": "犯罪嫌疑",
            "text": "被疑者が罪を犯したことを疑うに足りる相当な理由があるときは、"
          },
          {
            "id": "jp-323AC0000000131-a199-p1-s03",
            "role": "requirement",
            "tag": "事前令状",
            "text": "裁判官のあらかじめ発する逮捕状により、"
          },
          {
            "id": "jp-323AC0000000131-a199-p1-s04",
            "role": "effect",
            "tag": "逮捕",
            "text": "これを逮捕することができる。"
          },
          {
            "id": "jp-323AC0000000131-a199-p1-s05",
            "role": "limit",
            "tag": "軽微事件",
            "text": "ただし、三十万円（刑法、暴力行為等処罰に関する法律及び経済関係罰則の整備に関する法律の罪以外の罪については、当分の間、二万円）以下の罰金、拘留又は科料に当たる罪については、"
          },
          {
            "id": "jp-323AC0000000131-a199-p1-s06",
            "role": "requirement",
            "tag": "限定事由",
            "text": "被疑者が定まつた住居を有しない場合又は正当な理由がなく前条の規定による出頭の求めに応じない場合に限る。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a199-p2",
        "label": "第199条第2項",
        "studyTitle": "最優先",
        "purpose": "中立な裁判官に嫌疑と逮捕の必要性を事前審査させ、不要な逮捕状の発付を防ぎます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a199-p2-s01",
            "role": "actor",
            "tag": "発付主体",
            "text": "裁判官は、"
          },
          {
            "id": "jp-323AC0000000131-a199-p2-s02",
            "role": "requirement",
            "tag": "犯罪嫌疑",
            "text": "被疑者が罪を犯したことを疑うに足りる相当な理由があると認めるときは、"
          },
          {
            "id": "jp-323AC0000000131-a199-p2-s03",
            "role": "requirement",
            "tag": "請求",
            "text": "検察官又は司法警察員（警察官たる司法警察員については、国家公安委員会又は都道府県公安委員会が指定する警部以上の者に限る。次項及び第二百一条の二第一項において同じ。）の請求により、"
          },
          {
            "id": "jp-323AC0000000131-a199-p2-s04",
            "role": "effect",
            "tag": "逮捕状発付",
            "text": "前項の逮捕状を発する。"
          },
          {
            "id": "jp-323AC0000000131-a199-p2-s05",
            "role": "limit",
            "tag": "必要性",
            "text": "ただし、明らかに逮捕の必要がないと認めるときは、この限りでない。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a199-p3",
        "label": "第199条第3項",
        "studyTitle": "見ればよい",
        "purpose": "同一犯罪事実について逮捕状請求が繰り返される場合に、裁判所の審査資料を確保します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a199-p3-s01",
            "role": "actor",
            "tag": "通知主体",
            "text": "検察官又は司法警察員は、"
          },
          {
            "id": "jp-323AC0000000131-a199-p3-s02",
            "role": "requirement",
            "tag": "逮捕状請求",
            "text": "第一項の逮捕状を請求する場合において、"
          },
          {
            "id": "jp-323AC0000000131-a199-p3-s03",
            "role": "requirement",
            "tag": "前の請求等",
            "text": "同一の犯罪事実についてその被疑者に対し前に逮捕状の請求又はその発付があつたときは、"
          },
          {
            "id": "jp-323AC0000000131-a199-p3-s04",
            "role": "effect",
            "tag": "通知義務",
            "text": "その旨を裁判所に通知しなければならない。"
          }
        ]
      }
    ],
