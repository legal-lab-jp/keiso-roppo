  "study": {
    "title": "司法警察員の48時間",
    "topic": "逮捕",
    "priority": {
      "essay": "A",
      "preliminaryShort": "A"
    },
    "loadLabel": "時間を覚える",
    "oneLine": "警察段階で弁解の機会を保障し、釈放か、身体拘束時から48時間以内の検察官送致を要求します。",
    "trigger": "司法警察員が逮捕した被疑者をいつまで留置できるか、検察官送致が遅れた場合の効果を確認するとき。",
    "overview": "逮捕後の身体拘束を警察の判断だけで継続させないため、直ちに告知と弁解の機会を与え、留置の必要性を判断させます。必要がある場合でも、身体拘束時から48時間以内に検察官への送致手続が必要です。",
    "learning": {
      "remember": "告知→弁解→不要なら直ちに釈放／必要なら身体拘束時から48時間以内に検察官への送致手続。違反時は直ちに釈放。",
      "understand": "48時間は警察が被疑者を受け取った時ではなく、被疑者が身体を拘束された時から進むこと。",
      "lookup": "2項から4項の弁護人の有無・選任申出・国選弁護に関する詳細な教示内容は、必要時に確認します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a203-p1",
        "label": "第203条第1項",
        "studyTitle": "時間軸の核",
        "purpose": "警察段階の身柄拘束を短時間に限定し、弁解を聴いた上で釈放又は検察官送致へ進ませます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a203-p1-s01",
            "role": "actor",
            "tag": "処理主体",
            "text": "司法警察員は、"
          },
          {
            "id": "jp-323AC0000000131-a203-p1-s02",
            "role": "requirement",
            "tag": "逮捕・受取",
            "text": "逮捕状により被疑者を逮捕したとき、又は逮捕状により逮捕された被疑者を受け取つたときは、"
          },
          {
            "id": "jp-323AC0000000131-a203-p1-s03",
            "role": "requirement",
            "tag": "告知",
            "text": "直ちに犯罪事実の要旨及び弁護人を選任することができる旨を告げた上、"
          },
          {
            "id": "jp-323AC0000000131-a203-p1-s04",
            "role": "effect",
            "tag": "弁解",
            "text": "弁解の機会を与え、"
          },
          {
            "id": "jp-323AC0000000131-a203-p1-s05",
            "role": "effect",
            "tag": "不要なら釈放",
            "text": "留置の必要がないと思料するときは直ちにこれを釈放し、"
          },
          {
            "id": "jp-323AC0000000131-a203-p1-s06",
            "role": "requirement",
            "tag": "必要なら",
            "text": "留置の必要があると思料するときは"
          },
          {
            "id": "jp-323AC0000000131-a203-p1-s07",
            "role": "limit",
            "tag": "48時間",
            "text": "被疑者が身体を拘束された時から四十八時間以内に"
          },
          {
            "id": "jp-323AC0000000131-a203-p1-s08",
            "role": "effect",
            "tag": "送致手続",
            "text": "書類及び証拠物とともにこれを検察官に送致する手続をしなければならない。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a203-p5",
        "label": "第203条第5項",
        "studyTitle": "違反の効果",
        "purpose": "時間制限を実効化するため、送致手続が間に合わなければ身柄拘束を解かせます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a203-p5-s01",
            "role": "requirement",
            "tag": "時間違反",
            "text": "第一項の時間の制限内に送致の手続をしないときは、"
          },
          {
            "id": "jp-323AC0000000131-a203-p5-s02",
            "role": "effect",
            "tag": "釈放義務",
            "text": "直ちに被疑者を釈放しなければならない。"
          }
        ]
      }
    ],
    "omitted": "2項から4項の弁護人選任に関する詳細な告知・教示は、弁護分野と重なるため本カードでは省略します。",
