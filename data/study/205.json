    "title": "送致後24時間・全体72時間",
    "topic": "逮捕",
    "priority": {
      "essay": "A",
      "preliminaryShort": "A"
    },
    "loadLabel": "数字を最優先",
    "oneLine": "警察から送致された被疑者について、受取り後24時間かつ身体拘束時から72時間を勾留請求等の上限とします。",
    "trigger": "警察から検察官へ送致された後、いつまでに勾留請求・起訴・釈放をしなければならないかを計算するとき。",
    "overview": "203条の48時間に続く検察官段階を定めます。検察官が身柄を受け取ってから24時間以内という個別制限と、身体拘束開始から72時間以内という全体制限の双方を満たす必要があります。",
    "learning": {
      "remember": "受取りから24時間以内、かつ身体拘束時から72時間以内。勾留請求又は起訴をしなければ直ちに釈放。",
      "understand": "24時間と72時間は二者択一ではなく、両方の上限がかかること。203条の48時間から一続きで捉えます。",
      "lookup": "公訴提起時は勾留請求不要という3項も、時間計算と併せて確認します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a205-p1",
        "label": "第205条第1項",
        "studyTitle": "24時間",
        "purpose": "警察から身柄を受け取った検察官に速やかな事件処理を要求します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a205-p1-s01",
            "role": "actor",
            "tag": "処理主体",
            "text": "検察官は、"
          },
          {
            "id": "jp-323AC0000000131-a205-p1-s02",
            "role": "requirement",
            "tag": "203条送致",
            "text": "第二百三条の規定により送致された被疑者を受け取つたときは、"
          },
          {
            "id": "jp-323AC0000000131-a205-p1-s03",
            "role": "effect",
            "tag": "弁解",
            "text": "弁解の機会を与え、"
          },
          {
            "id": "jp-323AC0000000131-a205-p1-s04",
            "role": "effect",
            "tag": "不要なら釈放",
            "text": "留置の必要がないと思料するときは直ちにこれを釈放し、"
          },
          {
            "id": "jp-323AC0000000131-a205-p1-s05",
            "role": "requirement",
            "tag": "必要なら",
            "text": "留置の必要があると思料するときは"
          },
          {
            "id": "jp-323AC0000000131-a205-p1-s06",
            "role": "limit",
            "tag": "受取後24時間",
            "text": "被疑者を受け取つた時から二十四時間以内に"
          },
          {
            "id": "jp-323AC0000000131-a205-p1-s07",
            "role": "effect",
            "tag": "勾留請求",
            "text": "裁判官に被疑者の勾留を請求しなければならない。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a205-p2",
        "label": "第205条第2項",
        "studyTitle": "全体72時間",
        "purpose": "警察・検察を通じた逮捕後の身柄拘束全体に絶対的な時間上限を設けます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a205-p2-s01",
            "role": "actor",
            "tag": "対象制限",
            "text": "前項の時間の制限は、"
          },
          {
            "id": "jp-323AC0000000131-a205-p2-s02",
            "role": "limit",
            "tag": "身体拘束から72時間",
            "text": "被疑者が身体を拘束された時から七十二時間を超えることができない。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a205-p3",
        "label": "第205条第3項",
        "studyTitle": "起訴時の処理",
        "purpose": "期限内に起訴した場合は被告人の手続へ移るため、被疑者勾留の請求を不要とします。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a205-p3-s01",
            "role": "requirement",
            "tag": "期限内の起訴",
            "text": "前二項の時間の制限内に公訴を提起したときは、"
          },
          {
            "id": "jp-323AC0000000131-a205-p3-s02",
            "role": "effect",
            "tag": "請求不要",
            "text": "勾留の請求をすることを要しない。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a205-p4",
        "label": "第205条第4項",
        "studyTitle": "違反の効果",
        "purpose": "二つの時間制限を守らなかった場合に釈放を義務付けます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a205-p4-s01",
            "role": "requirement",
            "tag": "期限内になし",
            "text": "第一項及び第二項の時間の制限内に勾留の請求又は公訴の提起をしないときは、"
          },
          {
            "id": "jp-323AC0000000131-a205-p4-s02",
            "role": "effect",
            "tag": "釈放義務",
            "text": "直ちに被疑者を釈放しなければならない。"
          }
        ]
      }
    ],
