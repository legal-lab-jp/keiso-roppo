  "study": {
    "title": "緊急逮捕",
    "topic": "逮捕",
    "priority": {
      "essay": "A",
      "preliminaryShort": "A"
    },
    "loadLabel": "四要素",
    "oneLine": "重大犯罪の十分な嫌疑と緊急性がある場合に先行逮捕を認め、直後の令状請求と不発付時の釈放を要求します。",
    "trigger": "逮捕前に令状を取る時間がなかったとして緊急逮捕が行われた事案で、犯罪の重さ・嫌疑・緊急性・事後手続を検討するとき。",
    "overview": "事前令状を原則とする通常逮捕の例外です。対象犯罪を重い罪に限り、相当な理由より高い「十分な理由」、急速性と令状請求不能を要求し、逮捕直後の令状請求による司法審査を必須とします。",
    "learning": {
      "remember": "重大犯罪、十分な嫌疑、急速を要し事前の逮捕状を求められないこと、理由告知、直ちに事後令状請求、不発付なら直ちに釈放。",
      "understand": "無令状のまま終わる制度ではなく、緊急の先行逮捕を直後の司法審査に接続する例外であること。",
      "lookup": "対象犯罪の刑の閾値「死刑又は無期若しくは長期三年以上の拘禁刑」は、短答時に正確に確認します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a210-p1",
        "label": "第210条第1項",
        "studyTitle": "最優先",
        "purpose": "重大犯罪で逮捕機会を失う緊急時に限り先行逮捕を認め、事後の令状審査で濫用を防ぎます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a210-p1-s01",
            "role": "actor",
            "tag": "逮捕主体",
            "text": "検察官、検察事務官又は司法警察職員は、"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s02",
            "role": "requirement",
            "tag": "重大犯罪・十分な嫌疑",
            "text": "死刑又は無期若しくは長期三年以上の拘禁刑に当たる罪を犯したことを疑うに足りる十分な理由がある場合で、"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s03",
            "role": "requirement",
            "tag": "緊急性",
            "text": "急速を要し、裁判官の逮捕状を求めることができないときは、"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s04",
            "role": "requirement",
            "tag": "理由告知",
            "text": "その理由を告げて"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s05",
            "role": "effect",
            "tag": "先行逮捕",
            "text": "被疑者を逮捕することができる。"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s06",
            "role": "requirement",
            "tag": "逮捕後",
            "text": "この場合には、"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s07",
            "role": "effect",
            "tag": "直ちに令状請求",
            "text": "直ちに裁判官の逮捕状を求める手続をしなければならない。"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s08",
            "role": "requirement",
            "tag": "不発付",
            "text": "逮捕状が発せられないときは、"
          },
          {
            "id": "jp-323AC0000000131-a210-p1-s09",
            "role": "effect",
            "tag": "釈放義務",
            "text": "直ちに被疑者を釈放しなければならない。"
          }
        ]
      }
    ],
    "omitted": "2項は、事後に求める逮捕状へ200条の記載事項を準用する規定であり、省略します。",
