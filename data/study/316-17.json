  "study": {
    "title": "被告人側の予定主張と証拠請求",
    "topic": "公判前整理・証拠開示",
    "priority": {
      "essay": "B",
      "preliminaryShort": "A"
    },
    "loadLabel": "防御側の応答",
    "oneLine": "検察官の立証と証拠開示を受けた後、被告人側が予定する事実上・法律上の主張と証拠を明らかにします。",
    "trigger": "検察官側の開示後、被告人・弁護人がどの主張と証拠をいつ示す義務を負うかを確認するとき。",
    "overview": "検察官の証明予定事実と請求証拠・類型証拠の開示を受けてから、被告人側が予定主張と立証を示します。この順序により、防御側は検察官の立証構造を見た上で応答でき、その主張が316条の20の主張関連証拠開示の基礎になります。",
    "learning": {
      "remember": "13条書面＋14・15条の開示を受けた後／予定する事実上・法律上の主張があるとき／裁判所・検察官へ明示です。",
      "understand": "予定主張の明示は防御権の放棄ではなく、争点を特定し、その主張に関連する未開示証拠へ20条で到達するための接続点でもあること。",
      "lookup": "主張や証拠を後に追加・変更する場合は316条の22ですが、今回は本編から省略します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a316-17-p1",
        "label": "第316条の17第1項",
        "studyTitle": "予定主張の明示",
        "purpose": "検察官の立証・開示を踏まえて防御側の争点を明らかにし、以後の証拠整理と主張関連開示を可能にします。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a316-17-p1-s01",
            "role": "actor",
            "tag": "被告人側",
            "text": "被告人又は弁護人は、"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p1-s02",
            "role": "requirement",
            "tag": "検察官の書面と開示",
            "text": "第三百十六条の十三第一項の書面の送付を受け、かつ、第三百十六条の十四第一項並びに第三百十六条の十五第一項及び第二項の規定による開示をすべき証拠の開示を受けた場合において、"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p1-s03",
            "role": "requirement",
            "tag": "予定主張あり",
            "text": "その証明予定事実その他の公判期日においてすることを予定している事実上及び法律上の主張があるときは、"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p1-s04",
            "role": "effect",
            "tag": "主張を明示",
            "text": "裁判所及び検察官に対し、これを明らかにしなければならない。"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p1-s05",
            "role": "limit",
            "tag": "予断事項を制限",
            "text": "この場合においては、第三百十六条の十三第一項後段の規定を準用する。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a316-17-p2",
        "label": "第316条の17第2項",
        "studyTitle": "防御側証拠請求",
        "purpose": "被告人側の証明予定事実と、それを支える証拠を対応させて整理します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a316-17-p2-s01",
            "role": "actor",
            "tag": "被告人側",
            "text": "被告人又は弁護人は、"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p2-s02",
            "role": "requirement",
            "tag": "証明予定事実あり",
            "text": "前項の証明予定事実があるときは、"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p2-s03",
            "role": "effect",
            "tag": "証拠請求義務",
            "text": "これを証明するために用いる証拠の取調べを請求しなければならない。"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p2-s04",
            "role": "effect",
            "tag": "299条特則",
            "text": "この場合においては、第三百十六条の十三第三項の規定を準用する。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a316-17-p3",
        "label": "第316条の17第3項",
        "studyTitle": "期限設定",
        "purpose": "予定主張と証拠請求の時期を管理し、公判準備を計画的に進めます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a316-17-p3-s01",
            "role": "actor",
            "tag": "裁判所",
            "text": "裁判所は、"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p3-s02",
            "role": "requirement",
            "tag": "当事者の意見",
            "text": "検察官及び被告人又は弁護人の意見を聴いた上で、"
          },
          {
            "id": "jp-323AC0000000131-a316-17-p3-s03",
            "role": "effect",
            "tag": "期限設定",
            "text": "第一項の主張を明らかにすべき期限及び前項の請求の期限を定めることができる。"
          }
        ]
      }
    ],
