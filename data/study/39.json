  "study": {
    "title": "接見交通権と接見指定",
    "topic": "弁護",
    "priority": {
      "essay": "A",
      "preliminaryShort": "A"
    },
    "loadLabel": "最優先",
    "oneLine": "身体拘束中の被告人・被疑者と弁護人の秘密接見を保障し、起訴前の接見指定との限界を定めます。",
    "trigger": "弁護人との接見を捜査機関が遅らせた、時間・場所を指定した、物の授受を制限した事案。",
    "overview": "接見交通は、身体拘束中の者が弁護人の助言を受け、防御を準備するための中核的権利です。他方、起訴前には捜査との調整が必要となるため、3項が限定的な接見指定を認め、その指定にも防御権を不当に制限しない限界を置きます。",
    "learning": {
      "remember": "1項の秘密接見・授受、3項の主体、捜査上の必要、公訴提起前、日時・場所・時間、不当制限禁止。",
      "understand": "接見指定は接見を消滅させる権限ではなく、捜査と防御の機会を調整する制度です。",
      "lookup": "2項の物の授受に対する一般的規制根拠は条文で確認します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a39-p1",
        "label": "第39条第1項",
        "studyTitle": "最優先",
        "purpose": "身体拘束中でも、捜査機関等の立会いなしに弁護人の援助を受ける機会を保障します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a39-p1-s01",
            "role": "actor",
            "tag": "権利主体",
            "text": "身体の拘束を受けている被告人又は被疑者は、"
          },
          {
            "id": "jp-323AC0000000131-a39-p1-s02",
            "role": "actor",
            "tag": "相手方",
            "text": "弁護人又は弁護人を選任することができる者の依頼により弁護人となろうとする者（弁護士でない者にあつては、第三十一条第二項の許可があつた後に限る。）と"
          },
          {
            "id": "jp-323AC0000000131-a39-p1-s03",
            "role": "requirement",
            "tag": "秘密交通",
            "text": "立会人なくして"
          },
          {
            "id": "jp-323AC0000000131-a39-p1-s04",
            "role": "effect",
            "tag": "権利",
            "text": "接見し、又は書類若しくは物の授受をすることができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a39-p2",
        "label": "第39条第2項",
        "studyTitle": "理解",
        "purpose": "秘密交通を保障しつつ、逃亡・罪証隠滅・戒護上危険な物の授受を防ぐ一般的規制を可能にします。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a39-p2-s01",
            "role": "actor",
            "tag": "対象",
            "text": "前項の接見又は授受については、"
          },
          {
            "id": "jp-323AC0000000131-a39-p2-s02",
            "role": "effect",
            "tag": "規制根拠",
            "text": "法令（裁判所の規則を含む。以下同じ。）で、"
          },
          {
            "id": "jp-323AC0000000131-a39-p2-s03",
            "role": "requirement",
            "tag": "目的",
            "text": "被告人又は被疑者の逃亡、罪証の隠滅又は戒護に支障のある物の授受を防ぐため"
          },
          {
            "id": "jp-323AC0000000131-a39-p2-s04",
            "role": "limit",
            "tag": "必要限度",
            "text": "必要な措置を規定することができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a39-p3",
        "label": "第39条第3項",
        "studyTitle": "最優先",
        "purpose": "起訴前捜査の必要と接見交通権を調整し、指定が防御権を奪うことを防ぎます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a39-p3-s01",
            "role": "actor",
            "tag": "指定主体",
            "text": "検察官、検察事務官又は司法警察職員（司法警察員及び司法巡査をいう。以下同じ。）は、"
          },
          {
            "id": "jp-323AC0000000131-a39-p3-s02",
            "role": "requirement",
            "tag": "捜査上必要",
            "text": "捜査のため必要があるときは、"
          },
          {
            "id": "jp-323AC0000000131-a39-p3-s03",
            "role": "limit",
            "tag": "起訴前限定",
            "text": "公訴の提起前に限り、"
          },
          {
            "id": "jp-323AC0000000131-a39-p3-s04",
            "role": "effect",
            "tag": "指定権",
            "text": "第一項の接見又は授受に関し、その日時、場所及び時間を指定することができる。"
          },
          {
            "id": "jp-323AC0000000131-a39-p3-s05",
            "role": "limit",
            "tag": "限界",
            "text": "但し、その指定は、被疑者が防禦の準備をする権利を不当に制限するようなものであつてはならない。"
          }
        ]
      }
    ],
