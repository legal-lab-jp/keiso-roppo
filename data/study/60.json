  "study": {
    "title": "被告人勾留の要件・期間",
    "topic": "勾留",
    "priority": {
      "essay": "A",
      "preliminaryShort": "A"
    },
    "loadLabel": "最優先",
    "oneLine": "起訴後の被告人を勾留できる実体要件、期間、軽微事件の制限を定めます。",
    "trigger": "起訴後も身体拘束を続けられるか、勾留更新や軽微事件の勾留が許されるかを判断するとき。",
    "overview": "被告人の身体の自由を制約するため、犯罪嫌疑に加え、住居不定・罪証隠滅のおそれ・逃亡のおそれのいずれかを要求します。期間と更新にも制限を設け、拘束を必要な範囲に限定します。",
    "learning": {
      "remember": "嫌疑の相当な理由＋1号から3号のいずれか。期間は起訴日から2か月、原則1か月ごと更新。",
      "understand": "勾留理由の存在だけでなく、具体的事案では勾留の必要性・相当性も問題となること。",
      "lookup": "2項の更新回数例外と3項の罰金額は短答時に正確に確認します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a60-p1-intro",
        "label": "第60条第1項柱書",
        "studyTitle": "最優先",
        "purpose": "犯罪嫌疑と将来の手続上の危険を、被告人勾留の基本要件として限定します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a60-p1-intro-s01",
            "role": "actor",
            "tag": "主体",
            "text": "裁判所は、"
          },
          {
            "id": "jp-323AC0000000131-a60-p1-intro-s02",
            "role": "requirement",
            "tag": "嫌疑",
            "text": "被告人が罪を犯したことを疑うに足りる相当な理由がある場合で、"
          },
          {
            "id": "jp-323AC0000000131-a60-p1-intro-s03",
            "role": "requirement",
            "tag": "勾留理由",
            "text": "左の各号の一にあたるときは、"
          },
          {
            "id": "jp-323AC0000000131-a60-p1-intro-s04",
            "role": "effect",
            "tag": "効果",
            "text": "これを勾留することができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a60-p1-i1",
        "label": "第60条第1項第1号",
        "studyTitle": "三要件",
        "purpose": "住所不定により出頭確保が困難となる危険へ対応します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a60-p1-i1-s01",
            "role": "requirement",
            "tag": "住居不定",
            "text": "被告人が定まつた住居を有しないとき。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a60-p1-i2",
        "label": "第60条第1項第2号",
        "studyTitle": "三要件",
        "purpose": "証拠の散逸・変造や関係者への働き掛けにより審判が害されることを防ぎます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a60-p1-i2-s01",
            "role": "requirement",
            "tag": "罪証隠滅",
            "text": "被告人が罪証を隠滅すると疑うに足りる相当な理由があるとき。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a60-p1-i3",
        "label": "第60条第1項第3号",
        "studyTitle": "三要件",
        "purpose": "被告人の逃亡を防ぎ、公判への出頭と裁判の実効性を確保します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a60-p1-i3-s01",
            "role": "requirement",
            "tag": "逃亡",
            "text": "被告人が逃亡し又は逃亡すると疑うに足りる相当な理由があるとき。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a60-p2",
        "label": "第60条第2項",
        "studyTitle": "短答まで",
        "purpose": "身体拘束が無期限化しないよう基本期間と更新方法・回数を限定します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a60-p2-s01",
            "role": "requirement",
            "tag": "基本期間",
            "text": "勾留の期間は、公訴の提起があつた日から二箇月とする。"
          },
          {
            "id": "jp-323AC0000000131-a60-p2-s02",
            "role": "requirement",
            "tag": "更新要件",
            "text": "特に継続の必要がある場合においては、具体的にその理由を附した決定で、"
          },
          {
            "id": "jp-323AC0000000131-a60-p2-s03",
            "role": "effect",
            "tag": "更新",
            "text": "一箇月ごとにこれを更新することができる。"
          },
          {
            "id": "jp-323AC0000000131-a60-p2-s04",
            "role": "limit",
            "tag": "回数制限",
            "text": "但し、第八十九条第一号、第三号、第四号又は第六号にあたる場合を除いては、更新は、一回に限るものとする。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a60-p3",
        "label": "第60条第3項",
        "studyTitle": "短答",
        "purpose": "軽微事件では身体拘束の不利益が過大になりやすいため、住居不定の場合に限定します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a60-p3-s01",
            "role": "actor",
            "tag": "軽微事件",
            "text": "三十万円（刑法、暴力行為等処罰に関する法律（大正十五年法律第六十号）及び経済関係罰則の整備に関する法律（昭和十九年法律第四号）の罪以外の罪については、当分の間、二万円）以下の罰金、拘留又は科料に当たる事件については、"
          },
          {
            "id": "jp-323AC0000000131-a60-p3-s02",
            "role": "limit",
            "tag": "限定",
            "text": "被告人が定まつた住居を有しない場合に限り、"
          },
          {
            "id": "jp-323AC0000000131-a60-p3-s03",
            "role": "effect",
            "tag": "準用",
            "text": "第一項の規定を適用する。"
          }
        ]
      }
    ],
