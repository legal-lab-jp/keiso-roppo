  "study": {
    "title": "被告人の接見等禁止",
    "topic": "勾留",
    "priority": {
      "essay": "B",
      "preliminaryShort": "A"
    },
    "loadLabel": "39条と対比",
    "oneLine": "逃亡・罪証隠滅のおそれがあるとき、弁護人等以外との接見や物の授受を制限します。",
    "trigger": "勾留中の被告人について家族等との面会・書類授受が禁止された場合、弁護人接見まで禁止できるかを確認するとき。",
    "overview": "勾留目的を害する外部との接触を制限する一方、39条1項の弁護人等は対象から除き、防御権を保護します。糧食の授受にも明示的な限界があります。",
    "learning": {
      "remember": "逃亡又は罪証隠滅のおそれ、検察官請求又は職権、39条1項の者は除外、糧食は禁止・差押え不可。",
      "understand": "接見禁止が一般の第三者を対象とし、弁護人との秘密交通を消す制度ではないこと。",
      "lookup": "可能な処分は接見禁止、検閲、授受禁止、差押えです。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a81-p1",
        "label": "第81条",
        "studyTitle": "39条と対比",
        "purpose": "勾留目的を守りながら、弁護人等との接見交通と生活維持に必要な授受を保護します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a81-p1-s01",
            "role": "actor",
            "tag": "主体",
            "text": "裁判所は、"
          },
          {
            "id": "jp-323AC0000000131-a81-p1-s02",
            "role": "requirement",
            "tag": "危険",
            "text": "逃亡し又は罪証を隠滅すると疑うに足りる相当な理由があるときは、"
          },
          {
            "id": "jp-323AC0000000131-a81-p1-s03",
            "role": "requirement",
            "tag": "開始",
            "text": "検察官の請求により又は職権で、"
          },
          {
            "id": "jp-323AC0000000131-a81-p1-s04",
            "role": "limit",
            "tag": "弁護人除外",
            "text": "勾留されている被告人と第三十九条第一項に規定する者以外の者との"
          },
          {
            "id": "jp-323AC0000000131-a81-p1-s05",
            "role": "effect",
            "tag": "制限",
            "text": "接見を禁じ、又はこれと授受すべき書類その他の物を検閲し、その授受を禁じ、若しくはこれを差し押えることができる。"
          },
          {
            "id": "jp-323AC0000000131-a81-p1-s06",
            "role": "limit",
            "tag": "糧食",
            "text": "但し、糧食の授受を禁じ、又はこれを差し押えることはできない。"
          }
        ]
      }
    ],
