    "title": "勾留理由開示請求",
    "topic": "勾留",
    "priority": {
      "essay": "B",
      "preliminaryShort": "A"
    },
    "loadLabel": "請求者を確認",
    "oneLine": "勾留されている被告人と一定の関係者に、勾留理由を公開法廷で明らかにさせる入口を与えます。",
    "trigger": "誰が勾留理由開示を請求できるか、保釈・勾留取消し後も請求が残るかを確認するとき。",
    "overview": "身体拘束の根拠を公開の場で説明させ、恣意的な拘束を抑制します。本条は請求権者と、身体拘束が解消した場合の請求の失効を定めます。",
    "learning": {
      "remember": "本人、弁護人等、その他利害関係人。保釈・執行停止・取消し・勾留状失効で請求も失効。",
      "understand": "勾留理由開示は勾留取消しそのものではなく、理由を公開して統制する制度です。",
      "lookup": "公開法廷での手続は83条以下で確認します。"
    },
    "provisions": [
      {
        "id": "jp-323AC0000000131-a82-p1",
        "label": "第82条第1項",
        "studyTitle": "基本",
        "purpose": "身体拘束を受けている本人に、勾留理由を明らかにさせる権利を認めます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a82-p1-s01",
            "role": "actor",
            "tag": "請求者",
            "text": "勾留されている被告人は、"
          },
          {
            "id": "jp-323AC0000000131-a82-p1-s02",
            "role": "actor",
            "tag": "請求先",
            "text": "裁判所に"
          },
          {
            "id": "jp-323AC0000000131-a82-p1-s03",
            "role": "effect",
            "tag": "権利",
            "text": "勾留の理由の開示を請求することができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a82-p2",
        "label": "第82条第2項",
        "studyTitle": "短答",
        "purpose": "本人が請求しにくい場合にも制度を利用できるよう、請求権者を拡張します。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a82-p2-s01",
            "role": "actor",
            "tag": "請求者",
            "text": "勾留されている被告人の弁護人、法定代理人、保佐人、配偶者、直系の親族、兄弟姉妹その他利害関係人も、"
          },
          {
            "id": "jp-323AC0000000131-a82-p2-s02",
            "role": "effect",
            "tag": "権利",
            "text": "前項の請求をすることができる。"
          }
        ]
      },
      {
        "id": "jp-323AC0000000131-a82-p3",
        "label": "第82条第3項",
        "studyTitle": "失効事由",
        "purpose": "勾留が解消・停止された後は、理由開示だけを続ける手続上の必要がなくなるため請求を失効させます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a82-p3-s01",
            "role": "actor",
            "tag": "対象",
            "text": "前二項の請求は、"
          },
          {
            "id": "jp-323AC0000000131-a82-p3-s02",
            "role": "requirement",
            "tag": "失効事由",
            "text": "保釈、勾留の執行停止若しくは勾留の取消があつたとき、又は勾留状の効力が消滅したときは、"
          },
          {
            "id": "jp-323AC0000000131-a82-p3-s03",
            "role": "effect",
            "tag": "効果",
            "text": "その効力を失う。"
          }
        ]
      }
    ],
