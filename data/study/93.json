      {
        "id": "jp-323AC0000000131-a93-p3",
        "label": "第93条第3項",
        "studyTitle": "条件",
        "purpose": "保証金だけでは防げない逃亡・罪証隠滅等の危険を、住居制限その他の条件で抑えます。",
        "segments": [
          {
            "id": "jp-323AC0000000131-a93-p3-s01",
            "role": "requirement",
            "tag": "保釈時",
            "text": "保釈を許す場合には、"
